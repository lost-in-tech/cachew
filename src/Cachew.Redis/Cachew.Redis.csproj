<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cachew.Redis</RootNamespace>
    <PackageId>LostInTech.Cachew.Redis</PackageId>
    <Authors>Mohammad Ruhul Amin</Authors>
    <Description>Redis IDistributedCache for Cachew. Writes are sent fire-and-forget.</Description>
    <PackageTags>cache;caching;distributed;redis;cachew</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/lost-in-tech/cachew</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Cachew/Cachew.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.20" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cachew.Redis.Tests" />
    <!-- Lets NSubstitute (via Castle DynamicProxy) fake ILogger<RedisCacheBackplane>, which it cannot
         do for a type that is not visible to the proxy assembly. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
