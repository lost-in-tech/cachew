<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro-benchmarks for the hot paths, in the solution so a developer can run them on demand. They
    are not tests, so `dotnet test` skips the project. Run with:
    dotnet run -c Release (project tests/Cachew.Benchmarks)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cachew.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cachew/Cachew.csproj" />
  </ItemGroup>

</Project>
