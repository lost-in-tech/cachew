<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumes the packed nupkgs rather than the projects, so it catches packaging faults that the test
    suites cannot see: a missing dependency, a missing asset, a bad nuspec. It is deliberately not in
    cachew.slnx, because it cannot restore until the packages have been packed. See the Build section
    of the README for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cachew.Package.Smoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- NuGet caches by id and version, so a copy of the same version in the global cache would be
         reused instead of the freshly packed one. Keep this project's copy beside it. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)obj/packages</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LostInTech.Cachew" Version="$(Version)" />
    <PackageReference Include="LostInTech.Cachew.Redis" Version="$(Version)" />
    <!-- A console app adds these itself, so this also checks that the library does not need to. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

</Project>
